<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- To ask the decision model for the next step. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Apps Eklavya opens by package name; Android hides other apps from us unless they are listed. -->
    <queries>
        <package android:name="io.a24go.android.dev" />
        <package android:name="com.hevy" />
    </queries>

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config">

        <service
            android:name=".EklavyaService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>
    </application>
</manifest>
