<?xml version="1.0" encoding="utf-8"?>
<!-- The one screen: session on/off, the three things it needs, and the keys. Sections and dividers, no cards. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_3"
        android:paddingTop="@dimen/space_5"
        android:paddingEnd="@dimen/space_3"
        android:paddingBottom="@dimen/space_5">

        <TextView
            style="@style/Text.Headline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name" />

        <!-- The state is what gets read from across the room, so it is the largest thing here. -->
        <TextView
            android:id="@+id/status"
            style="@style/Text.Display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1" />

        <TextView
            android:id="@+id/status_detail"
            style="@style/Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:textColor="@color/muted" />

        <Button
            android:id="@+id/session"
            style="@style/Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch"
            android:layout_marginTop="@dimen/space_3" />

        <!-- More space above a heading than below it. -->
        <TextView
            style="@style/Text.Headline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_5"
            android:layout_marginBottom="@dimen/space_1"
            android:text="@string/section_setup" />

        <View style="@style/Divider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/row"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/Text.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/setup_screen_control" />

            <TextView
                android:id="@+id/screen_state"
                style="@style/Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/state_on"
                android:textColor="@color/muted" />

            <Button
                android:id="@+id/screen_action"
                style="@style/Button.Quiet"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch"
                android:text="@string/action_turn_on" />
        </LinearLayout>

        <View style="@style/Divider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/row"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/Text.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/setup_microphone" />

            <TextView
                android:id="@+id/mic_state"
                style="@style/Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/state_allowed"
                android:textColor="@color/muted" />

            <Button
                android:id="@+id/mic_action"
                style="@style/Button.Quiet"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch"
                android:text="@string/action_allow" />
        </LinearLayout>

        <View style="@style/Divider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/row"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/Text.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/setup_keys" />

            <TextView
                android:id="@+id/keys_state"
                style="@style/Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/muted" />

            <Button
                android:id="@+id/keys_action"
                style="@style/Button.Quiet"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch"
                android:text="@string/action_change" />
        </LinearLayout>

        <View style="@style/Divider" />

        <!-- Shown while a key is missing, or after "Change"; otherwise the row above says all there is to say. -->
        <LinearLayout
            android:id="@+id/keys_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <TextView
            style="@style/Text.Headline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_5"
            android:text="@string/section_keys" />

        <TextView
            style="@style/Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:labelFor="@+id/openai_key"
            android:text="@string/key_openai" />

        <EditText
            android:id="@+id/openai_key"
            style="@style/Text.Body"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch"
            android:layout_marginStart="-4dp"
            android:layout_marginEnd="-4dp"
            android:importantForAutofill="no"
            android:inputType="textPassword"
            android:singleLine="true" />

        <TextView
            style="@style/Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:labelFor="@+id/jev_key"
            android:text="@string/key_typesafe" />

        <EditText
            android:id="@+id/jev_key"
            style="@style/Text.Body"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch"
            android:layout_marginStart="-4dp"
            android:layout_marginEnd="-4dp"
            android:importantForAutofill="no"
            android:inputType="textPassword"
            android:singleLine="true" />

        <Button
            android:id="@+id/save_keys"
            style="@style/Button.Quiet"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch"
            android:layout_marginStart="-12dp"
            android:layout_marginTop="@dimen/space_1"
            android:text="@string/save_keys" />

        <TextView
            style="@style/Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:text="@string/keys_caption" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
