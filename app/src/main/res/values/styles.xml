<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Eklavya" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorControlActivated">@color/accent</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:textColorHint">@color/muted</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
    </style>

    <!-- Type roles: display, headline, body, caption. Nothing else is used. -->
    <style name="Text.Display" parent="android:Widget.TextView">
        <item name="android:textSize">32sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:textColor">@color/text</item>
    </style>
    <style name="Text.Headline" parent="android:Widget.TextView">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/muted</item>
    </style>
    <style name="Text.Body" parent="android:Widget.TextView">
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/text</item>
    </style>
    <style name="Text.Caption" parent="android:Widget.TextView">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>

    <style name="Button.Primary" parent="android:Widget.Material.Button">
        <item name="android:background">@drawable/button_primary</item>
        <item name="android:textColor">@color/button_primary_text</item>
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/touch</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <!-- A quiet action inside a row: text only, still a full-size touch target. -->
    <style name="Button.Quiet" parent="android:Widget.Material.Button.Borderless">
        <item name="android:textColor">@color/button_quiet_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/touch</item>
        <item name="android:minWidth">@dimen/touch</item>
    </style>
    <style name="Divider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/divider</item>
    </style>
</resources>
